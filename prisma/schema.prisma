generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String      @id @default(cuid())
  name                 String?
  email                String      @unique
  passwordHash         String
  emailVerified        Boolean     @default(false)

  stripeCustomerId     String?     @unique
  stripeSubscriptionId String?     @unique
  subscriptionStatus   String?
  subscriptionPriceId  String?
  cancelAtPeriodEnd    Boolean     @default(false)
  currentPeriodEnd     DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  sheets               LabelSheet[]
  memberships          OrganizationMember[]
  folders              SheetFolder[]
  passwordResetTokens  PasswordResetToken[]
  emailVerifyTokens    EmailVerifyToken[]
  sheetComments        SheetComment[]
  feedbacks            Feedback[]
  menuPackages         MenuPackage[]
  menuSections         MenuSection[]
  platedMenus          PlatedMenu[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerifyToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  invites   OrganizationInvite[]
  sheets    LabelSheet[]
  folders   SheetFolder[]
  menuPackages MenuPackage[]
  menuSections MenuSection[]
  platedMenus  PlatedMenu[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("member") // owner | member
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String       @default("member")
  token          String       @unique @default(cuid())
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SheetFolder {
  id             String        @id @default(cuid())
  name           String
  userId         String
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sheets         LabelSheet[]
}

model LabelSheet {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  folderId       String?
  title          String
  eventName      String?
  totalLabels    Int           @default(10)
  settings       Json?
  logoUrl        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  folder         SheetFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  items          LabelItem[]
  dishAnalyses   DishAnalysis[]
  comments       SheetComment[]
}

model LabelItem {
  id            String         @id @default(cuid())
  sheetId       String
  positionIndex Int
  foodName      String?
  description   String?
  diets         Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sheet         LabelSheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  analyses      DishAnalysis[]

  @@unique([sheetId, positionIndex])
}

model IngredientRule {
  id                 String    @id @default(cuid())
  ingredientName     String
  normalizedName     String    @unique

  containsGluten     Boolean   @default(false)
  containsDairy      Boolean   @default(false)
  containsEgg        Boolean   @default(false)
  containsSoy        Boolean   @default(false)
  containsNuts       Boolean   @default(false)
  containsShellfish  Boolean   @default(false)
  containsSesame     Boolean   @default(false)
  containsFish       Boolean   @default(false)

  isVegetarian       Boolean?
  isVegan            Boolean?

  confidence         String?   // low | medium | high
  notes              String?
  source             String?   // manual | chef_bot | imported
  verified           Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SheetComment {
  id        String     @id @default(cuid())
  sheetId   String
  userId    String
  body      String
  createdAt DateTime   @default(now())

  sheet     LabelSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sheetId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  rating    Int?
  body      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model DishAnalysis {
  id                    String      @id @default(cuid())
  sheetId               String
  labelItemId           String?

  foodName              String?
  description           String?

  matchedIngredients    Json?
  suggestedDiets        Json?
  possibleDiets         Json?
  cannotVerify          Json?

  confidence            String?     // low | medium | high
  reasoning             String?
  warnings              String?

  status                String      @default("unreviewed")
  // unreviewed | suggested | verified | needs_clarification

  reviewedBy            String?
  reviewedAt            DateTime?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  sheet                 LabelSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  labelItem             LabelItem?  @relation(fields: [labelItemId], references: [id], onDelete: SetNull)

  @@index([sheetId])
  @@index([labelItemId])
}
// ── Plated menu builder ────────────────────────────────────────────────
// Library sections/dishes are scoped to an org (or a user without one).
// PlatedMenu.content snapshots the chosen dishes so library edits never
// rewrite menus that were already built. A package (e.g. "Plated Dinner")
// groups the sections a menu of that type can pick from.

model MenuPackage {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  name           String
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections       MenuSection[]
  menus          PlatedMenu[]

  @@index([organizationId])
  @@index([userId])
}

model MenuSection {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  packageId      String?
  name           String
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package        MenuPackage?  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dishes         MenuDish[]

  @@index([packageId])

  @@index([organizationId])
  @@index([userId])
}

model MenuDish {
  id          String      @id @default(cuid())
  sectionId   String
  name        String
  description String      @default("") // one printed line per newline
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  section     MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model PlatedMenu {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  packageId      String?
  title          String        @default("Untitled Menu")
  welcomeText    String        @default("WELCOME")
  hostName       String        @default("")
  eventDate      String?       // YYYY-MM-DD
  content        Json          // { sections: [{ sectionId, name, dishes: [{ dishId, name, description }] }] }
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  package        MenuPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
}
